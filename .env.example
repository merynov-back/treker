# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=treker

# Адреса БД для запуску без Docker (у Docker підставляється автоматично)
BASE_URL=postgresql://postgres:postgres@localhost:5434/treker

# --- JWT ---
JWT_SECRET_KEY=заміни-на-довгий-випадковий-рядок
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Redis (для запуску без Docker) ---
REDIS_URL=redis://localhost:6380/0

# --- Кеш аналітики, сек ---
ANALYTICS_CACHE_TTL_SECONDS=300

# --- Захист входу: N невдалих спроб → блок на стільки секунд ---
LOGIN_MAX_ATTEMPTS=5
LOGIN_BLOCK_SECONDS=300

# --- Звідки можна ходити в API напряму (dev-сервер Vite). У Docker фронтенд іде через nginx ---
CORS_ORIGINS=["http://localhost:5173"]

# --- Пояс для «сьогодні» і «поточного місяця» ---
APP_TIMEZONE=Europe/Kyiv
